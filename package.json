{
  "name": "athena-proc",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "main": "./electron/main.cjs",
  "scripts": {
    "dev:react": "vite --host 127.0.0.1 --strictPort",
    "dev:electron": "concurrently -k \"npm:dev:react\" \"wait-on http://127.0.0.1:5173 && electron .\"",
